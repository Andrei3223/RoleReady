# Copy to .env and fill in your own values.

# Supabase (auth). The publishable key is safe in the browser, the secret/service_role key is not.
SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# n8n production webhooks (see ../docs/api.md)
VITE_API_BASE_URL="https://YOUR-N8N-HOST/webhook/career-profile"   # profile upload (POST)
VITE_N8N_PROFILE_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/profile"
VITE_N8N_JOBS_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/jobs"
VITE_N8N_JOBS_REFRESH_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/jobs-refresh"
VITE_N8N_COURSES_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/courses"
VITE_N8N_COURSES_REGENERATE_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/courses-regenerate"
VITE_N8N_JOB_REFERRAL_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/job-referral"
VITE_N8N_USER_DATA_RESET_WEBHOOK_URL="https://YOUR-N8N-HOST/webhook/user-data-reset"
