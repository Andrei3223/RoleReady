    {
      "id": "c0821835-e2e7-4451-9bc4-01076d1e253b",
      "name": "Assemble Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const courseRaw = $('Find Course').all().map(i => i.json).filter(r => r && r.course_id);\nconst modulesRaw = $('Find Course Modules').all().map(i => i.json).filter(r => r && r.module_id);\nconst learningRaw = $('Find User Learning').all().map(i => i.json).filter(r => r && r.user_id);\n\nif (courseRaw.length === 0) {\n  return [{ json: { success: false, error: 'course_not_found', course: null } }];\n}\n\nconst course = courseRaw[0];\nif (course.is_active === false) {\n  return [{ json: { success: false, error: 'course_inactive', course: null } }];\n}\n\nfunction parseArr(v) {\n  if (v === null || v === undefined || v === '') return [];\n  if (Array.isArray(v)) return v;\n  try { const p = JSON.parse(v); return Array.isArray(p) ? p : []; } catch (e) { return []; }\n}\n\nconst learningByModule = {};\nfor (const ul of learningRaw) {\n  learningByModule[ul.module_id] = ul;\n}\n\nconst modules = modulesRaw\n  .slice()\n  .sort((a, b) => (a.order_index ?? 0) - (b.order_index ?? 0))\n  .map(m => {\n    const ul = learningByModule[m.module_id] || {};\n    return {\n      module_id: m.module_id,\n      course_id: m.course_id ?? course.course_id,\n      order_index: m.order_index ?? 0,\n      title: m.title ?? null,\n      description: m.description ?? null,\n      content: m.content ?? null,\n      skill_name: m.skill_name ?? null,\n      resources: parseArr(m.resources_json),\n      importance_score: m.importance_score ?? 0,\n      market_demand_percent: m.market_demand_percent ?? 0,\n      trend_percent: m.trend_percent ?? 0,\n      status: ul.status ?? 'not_started',\n      progress_percent: ul.progress_percent ?? 0,\n      started_at: ul.started_at ?? null,\n      completed_at: ul.completed_at ?? null,\n      score: ul.score ?? null,\n    };\n  });\n\nconst total_modules = modules.length;\nconst completed_modules = modules.filter(m => (m.progress_percent ?? 0) >= 100).length;\nconst progress_percent = total_modules > 0\n  ? Math.round(modules.reduce((s, m) => s + (m.progress_percent ?? 0), 0) / total_modules)\n  : 0;\n\nlet status = 'not_started';\nif (progress_percent >= 100) status = 'completed';\nelse if (progress_percent > 0) status = 'in_progress';\n\nconst priority_score = learningRaw.reduce((max, ul) => Math.max(max, ul.priority_score ?? 0), 0);\n\nreturn [{ json: { success: true, course: {\n  course_id: course.course_id,\n  name: course.name ?? null,\n  description: course.description ?? null,\n  role: course.role ?? null,\n  version: course.version ?? null,\n  jobs_analyzed: course.jobs_analyzed ?? null,\n  skills_snapshot: parseArr(course.skills_snapshot_json),\n  generated_at: course.generated_at ?? null,\n  updated_at: course.updated_at ?? null,\n  status,\n  progress_percent,\n  completed_modules,\n  total_modules,\n  priority_score,\n  modules,\n} } }];"
      }
    },
