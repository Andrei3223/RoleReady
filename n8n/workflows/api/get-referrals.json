    {
      "id": "31c1655d-3b76-4153-97fe-15aaa245eb00",
      "name": "Assemble Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// referral_drafts rows for this user, grouped by job. Optional ?job_id= narrows to one job.\nconst q = $('Webhook GET referrals').first().json.query || {};\nconst jobFilter = String(q.job_id || '').trim();\n\nconst rows = $('Find Drafts').all().map(i => i.json).filter(r => r && r.job_id);\nconst byJob = {};\nfor (const r of rows) {\n  if (jobFilter && String(r.job_id) !== jobFilter) continue;\n  const g = byJob[r.job_id] || (byJob[r.job_id] = {\n    job_id: r.job_id, job_title: r.job_title || null, company: r.company || null, job_url: r.job_url || null,\n    status: 'no_contacts', contacts: [],\n  });\n  // marker row written by Referals when no contacts were found for this job\n  if (r.status === 'no_contacts' && !r.contact_linkedin_url && !r.contact_name) continue;\n  g.status = 'drafted';\n  g.contacts.push({\n    draft_id: r.id,                        // referral_drafts row id\n    contact_name: r.contact_name || null,\n    contact_linkedin_url: r.contact_linkedin_url || null,\n    contact_headline: r.contact_headline || null,\n    tier: r.tier || null,                  // alumni | ex_colleague | same_team | recruiter\n    score: r.score ?? 0,\n    match_reasons: String(r.match_reasons || '').split('; ').filter(Boolean),\n    email: r.email || null,\n    email_status: r.email_status || null,  // found | guessed | not_found\n    channel: r.channel || null,            // email | linkedin\n    subject: r.subject || null,\n    body: r.body || null,\n    linkedin_note: r.linkedin_note || null,\n    status: r.status || null,              // draft | needs_review | missing\n  });\n}\nconst jobs = Object.values(byJob);\nfor (const g of jobs) g.contacts.sort((a, b) => (b.score ?? 0) - (a.score ?? 0));\njobs.sort((a, b) => b.contacts.length - a.contacts.length);\n\nreturn [{ json: {\n  success: true,\n  count: jobs.length,\n  contacts_count: jobs.reduce((s, g) => s + g.contacts.length, 0),\n  ...(jobFilter ? { job_id: jobFilter } : {}),\n  jobs,\n} }];\n"
      }
    },
