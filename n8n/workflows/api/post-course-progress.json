    {
      "id": "46b42996-7ea2-4ee4-a000-d9d5b8a02135",
      "name": "Build Progress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $('Webhook POST course-progress').first().json.body || {};\nconst userId = ($('Find User').first().json.id ?? '').toString();\n\nconst courseId = (body.course_id ?? '').toString();\nconst moduleId = (body.module_id ?? '').toString();\n\n// Clamp progress into 0..100 when provided\nlet progress = body.progress_percent;\nif (progress !== undefined && progress !== null && progress !== '') {\n  progress = Number(progress);\n  if (Number.isNaN(progress)) progress = null;\n  else progress = Math.max(0, Math.min(100, progress));\n} else {\n  progress = null;\n}\n\nlet score = body.score;\nif (score !== undefined && score !== null && score !== '') {\n  score = Number(score);\n  if (Number.isNaN(score)) score = null;\n} else {\n  score = null;\n}\n\n// Explicit status wins; otherwise derive from progress\nlet status = body.status ? body.status.toString() : null;\nif (!status && progress !== null) {\n  if (progress >= 100) status = 'completed';\n  else if (progress > 0) status = 'in_progress';\n  else status = 'not_started';\n}\n\nconst nowIso = new Date().toISOString();\n\nreturn [{ json: {\n  user_id: userId,\n  course_id: courseId,\n  module_id: moduleId,\n  valid: !!(userId && courseId && moduleId),\n  progress_percent: progress,\n  score: score,\n  status: status,\n  now: nowIso,\n} }];"
      }
    },
