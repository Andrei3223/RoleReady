        "jsCode": "// Counts the rows each delete node actually removed.\nconst plan = $('Build Plan').first().json;\nconst n = (name) => $(name).all().filter(i => i.json && typeof i.json.id === 'number' && i.json.id > 0).length;\nconst deleted = {\n  user_jobs: n('Delete user_jobs'),\n  jobs: n('Delete jobs'),\n  referral_drafts: n('Delete referral_drafts'),\n  user_learning: n('Delete user_learning'),\n  courses: n('Delete courses'),\n  course_modules: n('Delete course_modules'),\n  job_preparations: n('Delete job_preparations'),\n  job_connections: n('Delete job_connections'),\n  connections: n('Delete connections'),\n};\nreturn [{ json: { ...plan.response, deleted, planned: plan.response.deleted } }];\n"
      }
