    {
      "id": "75c1c7ca-5f09-4d4a-9a55-02a1b226d9d0",
      "name": "Build Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        96
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Decides exactly which rows belong to this user. Nothing is deleted here.\nconst w = $('Webhook POST user-data-reset').first().json;\nconst b = (w.body && typeof w.body === 'object') ? w.body : {};\nconst q = w.query || {};\nconst A = String(b.auth_user_id ?? q.auth_user_id ?? '').trim();\nconst dv = b.dry_run ?? q.dry_run;\nconst dryRun = dv === true || dv === 'true' || dv === 1 || dv === '1';\n\nconst fail = (error) => [{ json: { action: 'respond', response: { success: false, error, auth_user_id: A || null, dry_run: dryRun } } }];\nif (!A) return fail('missing_auth_user_id');\n\nconst user = $('Find User').all().map(i => i.json).find(u => u && u.auth_user_id === A && u.id !== undefined && u.id !== null);\nif (!user) return fail('user_not_found');\nconst uid = String(user.id);   // users row id = the user_id used in user_jobs / user_learning\n\nconst rows = (n) => $(n).all().map(i => i.json).filter(r => r && r.id !== undefined && r.id !== null);\nconst userJobs = rows('Load all user_jobs');\nconst learning = rows('Load all user_learning');\nconst courses = rows('Load all courses');\nconst modules = rows('Load all course_modules');\nconst drafts = rows('Load all referral_drafts');\nconst preps = rows('Load all job_preparations');\nconst jobConns = rows('Load all job_connections');\nconst conns = rows('Load all connections');\n\nfunction parseArr(v) { if (!v) return []; if (Array.isArray(v)) return v; try { const p = JSON.parse(v); return Array.isArray(p) ? p : []; } catch (e) { return []; } }\n// A row that carries auth_user_id belongs to that auth user; user_id is only used when auth_user_id is empty.\nconst isMineUJ = (r) => r.auth_user_id ? r.auth_user_id === A : String(r.user_id ?? '') === uid;\nconst isMineUserId = (r) => { const v = String(r.user_id ?? ''); return v !== '' && (v === uid || v === A); };\n\nconst myUJ = userJobs.filter(isMineUJ);\nconst otherUJ = userJobs.filter(r => !isMineUJ(r));\nconst myDrafts = drafts.filter(r => r.auth_user_id === A);\nconst otherDrafts = drafts.filter(r => r.auth_user_id !== A);\nconst myLearning = learning.filter(r => String(r.user_id ?? '') === uid);\nconst otherLearning = learning.filter(r => String(r.user_id ?? '') !== uid);\nconst myPreps = preps.filter(isMineUserId), otherPreps = preps.filter(r => !isMineUserId(r));\nconst myJobConns = jobConns.filter(isMineUserId), otherJobConns = jobConns.filter(r => !isMineUserId(r));\nconst myConns = conns.filter(isMineUserId);\n\n// jobs: shared table. Only delete a job no other user references anywhere.\nconst usedByOthers = new Set();\notherUJ.forEach(r => r.job_id && usedByOthers.add(String(r.job_id)));\notherDrafts.forEach(r => r.job_id && usedByOthers.add(String(r.job_id)));\notherLearning.forEach(r => parseArr(r.related_job_ids_json).forEach(j => usedByOthers.add(String(j))));\notherPreps.forEach(r => r.job_id && usedByOthers.add(String(r.job_id)));\notherJobConns.forEach(r => r.job_id && usedByOthers.add(String(r.job_id)));\nconst myJobIds = new Set();\nmyUJ.forEach(r => r.job_id && myJobIds.add(String(r.job_id)));\nmyDrafts.forEach(r => r.job_id && myJobIds.add(String(r.job_id)));\nconst jobIdsToDelete = [...myJobIds].filter(j => !usedByOthers.has(j));\nconst sharedJobsKept = [...myJobIds].filter(j => usedByOthers.has(j));\n\n// courses: per-user course ids are course_<users.id>_<role>; older courses are only removed if no other user's learning uses them.\nconst prefix = 'course_' + uid + '_';\nconst coursesOthers = new Set(otherLearning.map(r => String(r.course_id ?? '')));\nconst courseCandidates = new Set(myLearning.map(r => String(r.course_id ?? '')).filter(Boolean));\ncourses.forEach(c => { if (String(c.course_id ?? '').startsWith(prefix)) courseCandidates.add(String(c.course_id)); });\nconst courseIdsToDelete = new Set([...courseCandidates].filter(c => !coursesOthers.has(c)));\nconst sharedCoursesKept = [...courseCandidates].filter(c => coursesOthers.has(c));\nconst modulesOthers = new Set(otherLearning.map(r => String(r.module_id ?? '')));\nconst courseRows = courses.filter(c => courseIdsToDelete.has(String(c.course_id)));\nconst moduleRows = modules.filter(m => courseIdsToDelete.has(String(m.course_id)) && !modulesOthers.has(String(m.module_id)));\n\nconst ids = {\n  referral_drafts: myDrafts.map(r => r.id),\n  user_learning: myLearning.map(r => r.id),\n  course_modules: moduleRows.map(r => r.id),\n  courses: courseRows.map(r => r.id),\n  user_jobs: myUJ.map(r => r.id),\n  job_preparations: myPreps.map(r => r.id),\n  job_connections: myJobConns.map(r => r.id),\n  connections: myConns.map(r => r.id),\n};\nconst counts = {};\nfor (const k of Object.keys(ids)) counts[k] = ids[k].length;\ncounts.jobs = jobIdsToDelete.length;\n\nconst last = user.pipeline_started_at ? new Date(user.pipeline_started_at).getTime() : 0;\nconst pipelineMayBeRunning = !!last && (Date.now() - last) < 30 * 60 * 1000;\n\nconst response = {\n  success: true,\n  dry_run: dryRun,\n  status: dryRun ? 'preview' : 'deleted',\n  auth_user_id: A,\n  user_row_id: user.id,\n  deleted: counts,\n  kept_shared: { jobs: sharedJobsKept.length, courses: sharedCoursesKept.length },\n  reset_user_fields: ['pipeline_started_at', 'last_job_refresh_at', 'last_course_refresh_at'],\n  profile_kept: true,\n  pipeline_may_be_running: pipelineMayBeRunning,\n};\nreturn [{ json: { action: dryRun ? 'respond' : 'delete', response, ids, job_ids: jobIdsToDelete, user_row_id: user.id } }];\n"
      }
    },
