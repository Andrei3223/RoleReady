      "parameters": {
        "jsCode": "const req = $('Normalize Input').first().json;\nconst pick = (items, key) => {\n  for (const it of items) {\n    const jj = (it && it.json) ? it.json : {};\n    if (jj[key] !== undefined && jj[key] !== null && jj[key] !== '') return jj;\n  }\n  return null;\n};\nconst draft = pick($('Get Draft For Gmail').all(), 'auth_user_id');\nlet error = null, code = null, http = 200;\nif (!draft) { error = 'Referral draft not found'; code = 'DRAFT_NOT_FOUND'; http = 404; }\nelse if (String(draft.auth_user_id) !== String(req.auth_user_id)) { error = 'Draft does not belong to the authenticated user'; code = 'FORBIDDEN'; http = 403; }\nelse if (!draft.email || String(draft.email).trim() === '') { error = 'Contact email is missing'; code = 'CONTACT_EMAIL_MISSING'; http = 422; }\nif (error) { return [{ json: { ok: false, success: false, error: error, code: code, http_code: http } }]; }\nreturn [{ json: { ok: true, http_code: 200, draft_row_id: draft.id, email: draft.email, subject: draft.subject, body: draft.body, contact_name: draft.contact_name } }];"
