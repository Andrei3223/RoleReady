    {
      "parameters": {
        "jsCode": "const c = $json;\nconst u = c.user || {};\nconst j = c.job || {};\nconst uj = c.userJob || {};\nconst d = c.draft || {};\nconst LF = String.fromCharCode(10);\nconst s = (v) => (v === undefined || v === null) ? '' : String(v);\nconst arr = (v) => { try { const a = JSON.parse(v); return Array.isArray(a) ? a : []; } catch (e) { return []; } };\nconst skills = arr(u.skills_json).join(', ');\nconst experience = arr(u.experience_json).join('; ');\nconst education = arr(u.education_json).join('; ');\nconst matched = arr(uj.matched_skills_json).join(', ');\nconst missing = arr(uj.missing_skills_json).join(', ');\nconst systemLines = [\n  'You are an expert career assistant that writes short, warm, human referral outreach messages.',\n  'Strict rules:',\n  '- NEVER invent work experience, companies, skills, education, achievements, relationships, or contact information.',\n  '- Only use facts explicitly provided below. If an important detail is missing, use a natural generic phrasing instead of inventing anything.',\n  '- Keep it concise, professional and genuinely human. Do NOT sound like mass AI-generated outreach.',\n  '- Do not fabricate a personal relationship with the contact beyond what the provided relationship data states.',\n  'Respond ONLY with a valid JSON object with exactly these keys: \"subject\" (string), \"body\" (string, the email body), \"linkedin_message\" (string, a short optional LinkedIn note under 300 characters).'\n];\nconst candidateName = (s(u.first_name) + ' ' + s(u.last_name)).trim();\nconst userLines = [\n  'CANDIDATE PROFILE:',\n  'Name: ' + candidateName,\n  'Email: ' + s(u.email),\n  'Location: ' + s(u.location),\n  'Profile summary: ' + s(u.profile_summary),\n  'Relevant skills: ' + skills,\n  'Experience: ' + experience,\n  'Education: ' + education,\n  '',\n  'TARGET JOB:',\n  'Title: ' + s(j.title),\n  'Company: ' + s(j.company_name),\n  'Location: ' + s(j.location),\n  'Job URL: ' + s(j.job_url),\n  'Description: ' + s(j.description).slice(0, 1500),\n  '',\n  'MATCH CONTEXT:',\n  'Match score: ' + s(uj.match_score),\n  'Match reason: ' + s(uj.match_reason),\n  'Matched skills: ' + matched,\n  'Missing skills: ' + missing,\n  'Application status: ' + s(uj.status),\n  '',\n  'CONTACT / CONNECTION:',\n  'Name: ' + s(d.contact_name),\n  'Headline/role: ' + s(d.contact_headline),\n  'Relationship tier: ' + s(d.tier),\n  'Relationship reasons: ' + s(d.match_reasons),\n  'Preferred channel: ' + s(d.channel),\n  'Previous contact status: ' + s(d.status),\n  '',\n  'Write the referral outreach now as JSON only.'\n];\nreturn [{ json: Object.assign({}, c, { prompt_system: systemLines.join(LF), prompt_user: userLines.join(LF) }) }];"
      },
