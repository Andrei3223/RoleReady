    {
      "parameters": {
        "jsCode": "const req = $('Normalize Input').first().json;\nconst pick = (items, key) => {\n  for (const it of items) {\n    const jj = (it && it.json) ? it.json : {};\n    if (jj[key] !== undefined && jj[key] !== null && jj[key] !== '') return jj;\n  }\n  return null;\n};\nconst user = pick($('Get User').all(), 'auth_user_id');\nconst job = pick($('Get Job').all(), 'job_id');\nconst userJob = pick($('Get User Job').all(), 'job_id');\nconst draft = pick($('Get Referral Draft').all(), 'auth_user_id');\nlet error = null, code = null, http = 200;\nif (!user) { error = 'Authenticated user not found'; code = 'USER_NOT_FOUND'; http = 404; }\nelse if (!job) { error = 'Job not found'; code = 'JOB_NOT_FOUND'; http = 404; }\nelse if (!userJob) { error = 'User is not linked to this job'; code = 'USER_JOB_NOT_FOUND'; http = 404; }\nelse if (!draft) { error = 'Referral draft/contact not found for this user and job'; code = 'DRAFT_NOT_FOUND'; http = 404; }\nelse if (String(draft.auth_user_id) !== String(req.auth_user_id)) { error = 'Draft does not belong to the authenticated user'; code = 'FORBIDDEN'; http = 403; }\nelse if (String(draft.job_id) !== String(req.job_id)) { error = 'Draft does not match the requested job'; code = 'JOB_MISMATCH'; http = 403; }\nif (error) {\n  return [{ json: { ok: false, success: false, error: error, code: code, http_code: http } }];\n}\nreturn [{ json: { ok: true, http_code: 200, draft_row_id: draft.id, req: req, user: user, job: job, userJob: userJob, draft: draft } }];"
      },
