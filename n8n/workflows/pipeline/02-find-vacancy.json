    {
      "parameters": {
        "jsCode": "const userJobsRaw = $('Find User Jobs').all().map(i => i.json);\nconst jobsRaw = $('Find Jobs').all().map(i => i.json);\n\n// Drop empty placeholder items produced by alwaysOutputData when there are no rows\nconst userJobs = userJobsRaw.filter(r => r && r.user_id);\n\nconst jobsById = {};\nfor (const j of jobsRaw) {\n  if (j && j.job_id) jobsById[j.job_id] = j;\n}\n\nfunction parseArr(v) {\n  if (v === null || v === undefined || v === '') return [];\n  if (Array.isArray(v)) return v;\n  try {\n    const parsed = JSON.parse(v);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch (e) {\n    return [];\n  }\n}\n\n// Interview-prep plan written by get_materials into user_jobs.prep_* (null until prep_status = 'ready')\nfunction prepOf(uj) {\n  if (uj.prep_status !== 'ready') return null;\n  return {\n    role_type: uj.prep_role_type ?? null,\n    skill_gaps: parseArr(uj.prep_skill_gaps_json),            // [{skill, why}]\n    courses: parseArr(uj.prep_courses_json),                   // [{title, url, why}]\n    practice: parseArr(uj.prep_practice_json),                 // [{title, url, type, why}]\n    interview_insights: parseArr(uj.prep_interview_insights_json), // [{insight, source_url}]\n    likely_questions: parseArr(uj.prep_likely_questions_json), // [{question, answer_hint, source}]\n    plan: parseArr(uj.prep_plan_json),                         // [{day, focus, tasks[]}]\n    plan_markdown: uj.prep_plan_markdown ?? null,\n    data_quality: uj.prep_data_quality ?? null,\n    updated_at: uj.prep_updated_at ?? null,\n  };\n}\n\nconst result = [];\nfor (const uj of userJobs) {\n  if (uj.hidden === true) continue;\n  const job = jobsById[uj.job_id];\n  if (!job) continue;\n  if (job.is_active === false) continue;\n\n  result.push({\n    id: job.job_id,\n    title: job.title ?? null,\n    company_name: job.company_name ?? null,\n    company_url: job.company_url ?? null,\n    job_url: job.job_url ?? null,\n    location: job.location ?? null,\n    remote_type: job.remote_type ?? null,\n    employment_type: job.employment_type ?? null,\n    description: job.description ?? null,\n    seniority: job.seniority ?? null,\n    salary_min: job.salary_min ?? null,\n    salary_max: job.salary_max ?? null,\n    salary_currency: job.salary_currency ?? null,\n    published_at: job.published_at ?? null,\n\n    match_score: uj.match_score ?? null,\n    priority_score: uj.priority_score ?? null,\n    status: uj.status ?? null,\n    match_reason: uj.match_reason ?? null,\n    company_risk_score: uj.company_risk_score ?? null,\n    saved: uj.saved ?? false,\n    applied_at: uj.applied_at ?? null,\n    interview_at: uj.interview_at ?? null,\n\n    matched_skills: parseArr(uj.matched_skills_json),\n    missing_skills: parseArr(uj.missing_skills_json),\n\n    // 'ready' when the interview-prep plan exists, otherwise 'pending' (get_materials still has to run)\n    prep_status: uj.prep_status === 'ready' ? 'ready' : 'pending',\n    prep: prepOf(uj),\n  });\n}\n\nresult.sort((a, b) => {\n  const p = (b.priority_score ?? 0) - (a.priority_score ?? 0);\n  if (p !== 0) return p;\n  return (b.match_score ?? 0) - (a.match_score ?? 0);\n});\n\nreturn [{ json: { success: true, count: result.length, jobs: result } }];\n"
      },
