      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/valig~linkedin-jobs-scraper/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Apify API (Header Auth)"
        }
      },
      "notes": "Runs Actor valig/linkedin-jobs-scraper once per search and returns its dataset items.",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000
    },
    {
      "id": "91663cb6-15d8-411f-ab64-4f30f0bf1c31",
      "name": "Collect jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "parameters": {
        "jsCode": "const seen = new Set();\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j || (!j.title && !j.jobTitle && !j.id && !j.jobId && !j.link && !j.url)) continue;\n  const key = j.id || j.jobId || j.link || j.url || (String(j.title || '') + '|' + String(j.companyName || '') + '|' + String(j.location || ''));\n  if (seen.has(key)) continue;\n  seen.add(key);\n  out.push({ json: j });\n}\nreturn out;"
      },
      "notes": "All jobs from every search, duplicates removed."
    },
    {
      "id": "951501c8-7af7-4d05-a99b-5f764addd484",
      "name": "Aggregate for AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "jsCode": "function arr(v){ if(!v) return []; if(Array.isArray(v)) return v; try{ const p = JSON.parse(v); return Array.isArray(p) ? p : []; }catch(e){ return []; } }\n\nconst u = $('When Called').first().json;\nconst jobs = $input.all().map(function(it){ return it.json; }).filter(function(j){ return j && (j.title || j.jobTitle || j.id || j.jobId || j.link || j.url); });\n\nconst criteria = {\n  roles: arr(u.target_roles_json),\n  locations: arr(u.target_locations_json),\n  skills: arr(u.skills_json),\n  employment_type: u.employment_type || null,\n  remote_preference: u.remote_preference || null,\n  salary_min: (u.salary_min === undefined ? null : u.salary_min),\n  preferred_industries: arr(u.preferred_industries_json),\n  profile_summary: u.profile_summary || ''\n};\n\nconst slim = jobs.map(function(j, i){\n  return {\n    index: i,\n    title: j.title || j.jobTitle || '',\n    company: j.companyName || j.company || '',\n    location: j.location || '',\n    employment_type: j.employmentType || j.contractType || '',\n    seniority: j.experienceLevel || j.seniorityLevel || '',\n    description: String(j.description || j.descriptionText || '').slice(0, 1200)\n  };\n});\n\nreturn [{ json: { criteria: criteria, jobs: slim } }];"
      },
      "notes": "Builds a single payload (candidate criteria + indexed job list) for the AI, dropping empty placeholder items."
    },
    {
      "id": "719336f5-5202-45d4-842d-6bac695adf2a",
      "name": "AI: score & select jobs",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "You are a strict job-matching assistant. You receive a JSON object with \"criteria\" (the candidate profile and preferences) and \"jobs\" (an indexed list of vacancies). Select ONLY the jobs that genuinely fit the candidate; exclude weak matches, roles that are too senior, and locations the candidate did not want. For each selected job return: index (the job index from the input), match_score (0-100), priority_score (0-100, how strongly to surface it), company_risk_score (0-100, higher = riskier employer), status (always \"discovered\"), match_reason (1-2 sentences), matched_skills (candidate skills the job needs), missing_skills (skills the job needs the candidate lacks), and required_skills (the key skills the job itself requires). Return nothing but the structured object.",
          "maxTokens": 3000,
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "job_selection",
              "schema": "{\"type\":\"object\",\"properties\":{\"jobs\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"index\":{\"type\":\"integer\"},\"match_score\":{\"type\":\"integer\"},\"priority_score\":{\"type\":\"integer\"},\"company_risk_score\":{\"type\":\"integer\"},\"status\":{\"type\":\"string\"},\"match_reason\":{\"type\":\"string\"},\"matched_skills\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"missing_skills\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"required_skills\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"index\",\"match_score\",\"priority_score\",\"company_risk_score\",\"status\",\"match_reason\",\"matched_skills\",\"missing_skills\",\"required_skills\"],\"additionalProperties\":false}}},\"required\":[\"jobs\"],\"additionalProperties\":false}",
              "strict": true
            }
          },
          "temperature": 0.2
        }
      },
      "credentials": {
        "openAiApi": {
          "name": "OpenAI account"
        }
      }
    },
    {
      "id": "c218b56f-91c4-4da7-8933-198f60422c5e",
      "name": "Map results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
      "parameters": {
        "jsCode": "const parsed = $input.first().json;\nlet obj = null;\nif (parsed && parsed.output && parsed.output[0] && parsed.output[0].content && parsed.output[0].content[0]) {\n  obj = parsed.output[0].content[0].text;\n}\nif (typeof obj === 'string') { try { obj = JSON.parse(obj); } catch (e) { obj = {}; } }\nif (!obj) obj = {};\nconst selected = Array.isArray(obj.jobs) ? obj.jobs : [];\n\nconst fullJobs = $('Collect jobs').all().map(function(i){ return i.json; });\nconst u = $('When Called').first().json;\nconst nowIso = new Date().toISOString();\nconst userId = (u.id !== undefined && u.id !== null) ? String(u.id) : (u.user_id ? String(u.user_id) : '');\nconst authId = u.auth_user_id || '';\n\nfunction numOrNull(v){ if (v === null || v === undefined || v === '') return null; const n = Number(v); return isFinite(n) ? n : null; }\n\nconst rows = [];\nfor (const s of selected) {\n  const idx = s.index;\n  const full = (idx !== undefined && fullJobs[idx]) ? fullJobs[idx] : null;\n  if (!full) continue;\n\n  const jobUrl = full.link || full.url || full.jobUrl || full.jobPostingUrl || '';\n  const extId = full.id || full.jobId || full.jobPostingId || null;\n  const jobId = extId ? ('linkedin:' + String(extId)) : ('linkedin:' + (jobUrl || (String(full.title || '') + '|' + String(full.companyName || ''))));\n\n  const matched = Array.isArray(s.matched_skills) ? s.matched_skills : [];\n  const missing = Array.isArray(s.missing_skills) ? s.missing_skills : [];\n  const required = Array.isArray(s.required_skills) ? s.required_skills : [];\n  const salMin = numOrNull(full.salaryMin || full.salary_min);\n  const salMax = numOrNull(full.salaryMax || full.salary_max);\n  const title = full.title || full.jobTitle || null;\n  const company = full.companyName || full.company || null;\n  const companyUrl = full.companyUrl || full.companyLinkedinUrl || null;\n  const location = full.location || null;\n  const remoteType = full.workplaceType || full.remoteType || null;\n  const empType = full.employmentType || full.contractType || null;\n  const description = full.description || full.descriptionText || null;\n  const seniority = full.experienceLevel || full.seniorityLevel || null;\n  const publishedAt = full.postedAt || full.publishedAt || full.listedAt || null;\n  const matchScore = numOrNull(s.match_score);\n  const priorityScore = numOrNull(s.priority_score);\n  const riskScore = numOrNull(s.company_risk_score);\n  const status = s.status || 'discovered';\n  const reason = s.match_reason || '';\n\n  rows.push({\n    job_id: jobId, source: 'linkedin', external_job_id: extId ? String(extId) : null, job_key: jobId,\n    title: title, company_name: company, company_url: companyUrl, job_url: jobUrl || null,\n    location: location, remote_type: remoteType, employment_type: empType, description: description,\n    required_skills_json: JSON.stringify(required), preferred_skills_json: null, seniority: seniority,\n    salary_min: salMin, salary_max: salMax, published_at: publishedAt, fetched_at: nowIso,\n    is_active: true, raw_data_json: JSON.stringify(full),\n    user_id: userId, auth_user_id: authId, match_score: matchScore, status: status,\n    match_reason: reason, matched_skills_json: JSON.stringify(matched), missing_skills_json: JSON.stringify(missing),\n    priority_score: priorityScore, company_risk_score: riskScore, saved: false, hidden: false,\n    created_at: nowIso, updated_at: nowIso\n  });\n}\n\nreturn [{ json: { rows: rows, saved_count: rows.length } }];"
      },
      "notes": "Joins the AI selection back to full job data and builds table rows for jobs + user_jobs."
    },
