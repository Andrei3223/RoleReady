    {
      "id": "6a558bc6-9902-4f37-bd42-203d16351f62",
      "name": "Build LinkedIn searches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const u = $input.first().json;\nfunction arr(v){ if(!v) return []; if(Array.isArray(v)) return v; try{ const p = JSON.parse(v); return Array.isArray(p) ? p : []; }catch(e){ return []; } }\n\nconst roles = arr(u.target_roles_json);\nconst rolesF = roles.length ? roles : ['ML Engineer'];\n// LinkedIn returns nothing for a bare city ('Amsterdam'), so a country is always added.\n// users.country is empty for some users (profile_update does not always set it) -> default Netherlands.\nconst country = (u.country ? String(u.country).trim() : '') || 'Netherlands';\nfunction qualify(loc){\n  const l = String(loc || '').trim();\n  if (!l) return country;\n  return l.toLowerCase().indexOf(country.toLowerCase()) !== -1 ? l : (l + ', ' + country);\n}\nconst locs = arr(u.target_locations_json).map(qualify);\nconst locsF = locs.length ? locs : [country];\n\nconst typeMap = { 'full-time':'F', 'part-time':'P', 'contract':'C', 'temporary':'T', 'internship':'I' };\nlet jt = '';\nif (u.employment_type) { const code = typeMap[String(u.employment_type).toLowerCase()]; if (code) jt = code; }\n\nconst out = [];\nfor (const role of rolesF) {\n  for (const location of locsF) {\n    const urlParam = [{ key: 'distance', value: '25' }];\n    if (jt) urlParam.push({ key: 'f_JT', value: jt });\n    out.push({ json: { keywords: role, location: location, datePosted: 'r2592000', limit: 10, titleExclude: [], urlParam: urlParam } });\n  }\n}\nreturn out;"
      },
      "notes": "One LinkedIn search per target role x target location, taken from the user row."
    },
    {
      "id": "d69ad8de-70d4-4ecf-a20a-160df9c7972e",
      "name": "Apify: LinkedIn Jobs",
