    {
      "id": "3fd52ffb-1a64-4245-858e-5f8379396923",
      "name": "Keep user choices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ],
      "parameters": {
        "jsCode": "// Jobs that are already in user_jobs keep the user's choices: saved, hidden, status and created_at.\n// Only the AI scores / reasons / skills and updated_at are refreshed. applied_at and interview_at are never written here.\nconst rows = ($('Map results').first().json.rows) || [];\nconst existing = {};\nfor (const i of $input.all()) {\n  const r = i.json;\n  if (r && r.job_id) existing[r.job_id] = r;\n}\nconst out = rows.map(r => {\n  const ex = existing[r.job_id];\n  if (!ex) return r;\n  return {\n    ...r,\n    saved: ex.saved === true,\n    hidden: ex.hidden === true,\n    status: ex.status || r.status,\n    created_at: ex.created_at || r.created_at,\n  };\n});\nreturn [{ json: { rows: out, saved_count: out.length, new_count: out.filter(r => !existing[r.job_id]).length } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "notes": "Jobs found again keep what the user did with them; only scores and reasons are refreshed."
    },
    {
      "id": "f6610164-2f2f-4460-b4d2-8e94f229a007",
      "name": "Prep input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        256
      ],
      "parameters": {
        "jsCode": "// One item for the background jobs. Runs after the save branch (n8n runs the upper branch first).\n// Skipped when the pipeline was already started for this user less than 30 minutes ago\n// (get_materials / Referals may still be running; pending work is picked up by the next run).\nconst u = $('When Called').first().json;\nif (!u.auth_user_id || u.id === undefined || u.id === null) return [];\nconst last = u.pipeline_started_at ? new Date(u.pipeline_started_at).getTime() : 0;\nif (last && Date.now() - last < 30 * 60 * 1000) return [];\nreturn [{ json: { auth_user_id: String(u.auth_user_id), user_row_id: u.id } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "notes": "Runs after the save branch above (branches run top to bottom)."
    },
